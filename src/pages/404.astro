---
import '../styles/global.css';
import { languages, site } from '../data';
import { asset, pagePath } from '../lib/url';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>404 | {site.name}</title>
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <main class="field field--main" style="min-height: 100svh; display: grid; align-content: center;">
      <h1 class="display" style="font-size: clamp(5rem, 22vw, 16rem); line-height: 0.85;">404</h1>
      <p style="margin-top: 24px; max-width: 40ch;">
        <span lang="es">Esta página no existe.</span> <span lang="en">This page does not exist.</span>
      </p>
      <p class="actions">
        {
          languages.map((l) => (
            <a class="btn" href={pagePath(l)} hreflang={l} lang={l}>
              {l === 'es' ? 'Ir al inicio' : 'Go to the home page'}
            </a>
          ))
        }
      </p>
    </main>
  </body>
</html>
