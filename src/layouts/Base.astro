---
import '../styles/global.css';
/* La capa de estilo va aparte: con @import quedaría antes de las reglas de global.css y perdería. */
import '../styles/lc.css';
import heroFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-300-normal.woff2?url';
import bodyFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { getContent, languages, defaultLang, site, type Lang } from '../data';
import { absolute, asset, pagePath } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const url = absolute(pagePath(lang), Astro.site);
const alternates = languages.map((l) => ({ lang: l, href: absolute(pagePath(l), Astro.site) }));
const otherLocale = languages.find((l) => l !== lang)!;
const ogImage = absolute(asset('og.png'), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: t.meta.jobTitle,
  url,
  image: ogImage,
  inLanguage: t.meta.htmlLang,
  knowsAbout: ['Java', 'SQL Server', 'Apache Tomcat', 'JavaScript', 'Spring Boot', 'Relational databases'],
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={url} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(pagePath(defaultLang), Astro.site)} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={getContent(otherLocale).meta.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05080f" />

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      /* El sitio es solo oscuro. La clase `js` habilita los controles que solo funcionan con JavaScript. */
      document.documentElement.classList.add('js');
    </script>
    <script is:inline>
      /* Movimiento: solo con JS y sin prefers-reduced-motion. La intro, solo en la primera
         visita de la sesión. Si sessionStorage falla, no hay intro. Sin esta clase no hay
         ningún estado oculto en el CSS: todo el contenido se ve de una. */
      (function () {
        var d = document.documentElement;
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          d.classList.add('motion');
          if (!sessionStorage.getItem('intro-seen')) {
            sessionStorage.setItem('intro-seen', '1');
            d.classList.add('intro-on', 'first');
          }
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.ui.skip}</a>
    <slot />
    <script>
      import '../scripts/motion';
      import '../scripts/fx';
    </script>
  </body>
</html>
