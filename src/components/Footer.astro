---
import { getContent, site, type Lang } from '../data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<footer class="footer">
  <p>© {site.year} {site.name}. {t.ui.footerRights}</p>
  <p class="credit">{t.ui.footerCredit}</p>
  <a href="#top">{t.ui.footerTop}</a>
</footer>
