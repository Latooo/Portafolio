---
import { getContent, languages, site, type Lang } from '../data';
import { pagePath } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const other = languages.find((l) => l !== lang)!;
---

<nav class="nav" aria-label={t.ui.navLabel}>
  <a class="brand" href="#top" translate="no">{site.name}</a>
  <span class="links">
    <a href="#about">{t.ui.navAbout}</a>
    <a href="#process">{t.ui.navProcess}</a>
    <a href="#projects">{t.ui.navProjects}</a>
    <a href="#experience">{t.ui.navExperience}</a>
    <a href="#education">{t.ui.navEducation}</a>
  </span>
  <span class="ctls">
    <a class="ctl" href={pagePath(other)} hreflang={other} lang={other} data-lang-switch
      >{t.ui.langCode}<span class="sr-only"> ({t.ui.langName})</span></a
    >
    <a class="ctl ctl--fill" href="#contact">{t.ui.navCta}</a>
  </span>
</nav>


<script is:inline>
  (function () {
    /* El cambio de idioma conserva la sección en la que estás. */
    var l = document.querySelector('[data-lang-switch]');
    if (l) {
      l.addEventListener('click', function () {
        if (location.hash && l.href.indexOf('#') < 0) l.href += location.hash;
      });
    }
  })();
</script>
