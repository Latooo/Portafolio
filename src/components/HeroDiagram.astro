---
/**
 * Diagrama vivo del hero: el recorrido de una petición en el tipo de sistema que construyo.
 * Navegador → API REST (Java) → reglas de negocio → transacción → SQL Server → respuesta,
 * con los errores yendo a los logs de Tomcat. Al estilo de los diagramas de langchain.com.
 *
 * Es SVG en línea, sin JS: los pulsos son trazos discontinuos animados con CSS
 * (stroke-dashoffset). Con reduced-motion queda el diagrama quieto y completo.
 */
import { getContent, type Lang } from '../data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = getContent(lang).diagram;
---

<figure class="hd" role="img" aria-label={d.alt}>
  <svg class="hd-h" viewBox="0 0 1000 300" aria-hidden="true">
    <!-- contenedor del núcleo -->
    <rect class="hd-core" x="420" y="34" width="320" height="214" rx="12" />
    <text class="hd-cap" x="440" y="58">{d.core}</text>

    <!-- aristas (base) -->
    <g class="hd-edges">
      <path id="e1" d="M180 150 H252" />
      <path id="e2" d="M402 150 C 425 150, 425 104, 452 104" />
      <path id="e3" d="M580 128 V 168" />
      <path id="e4" d="M708 192 C 740 192, 745 150, 784 150" />
      <path id="e5" d="M892 122 C 892 6, 108 6, 108 122" />
      <path id="e6" d="M327 178 V 236" />
    </g>

    <!-- pulsos que recorren cada arista -->
    <g class="hd-pulses">
      <path pathLength="100" class="p p1" d="M180 150 H252" />
      <path pathLength="100" class="p p2" d="M402 150 C 425 150, 425 104, 452 104" />
      <path pathLength="100" class="p p3" d="M580 128 V 168" />
      <path pathLength="100" class="p p4" d="M708 192 C 740 192, 745 150, 784 150" />
      <path pathLength="100" class="p p5" d="M892 122 C 892 6, 108 6, 108 122" />
      <path pathLength="100" class="p p6" d="M327 178 V 236" />
    </g>

    <!-- nodos -->
    <g class="hd-node n1">
      <rect x="36" y="122" width="144" height="56" rx="8" />
      <text x="108" y="148">{d.browser}</text>
      <text class="sub" x="108" y="166">HTTPS</text>
    </g>
    <g class="hd-node n2">
      <rect x="252" y="122" width="150" height="56" rx="8" />
      <text x="327" y="148">API REST</text>
      <text class="sub" x="327" y="166">Java</text>
    </g>
    <g class="hd-node n3">
      <rect x="452" y="80" width="256" height="48" rx="8" />
      <text x="580" y="109">{d.rules}</text>
    </g>
    <g class="hd-node n4">
      <rect x="452" y="168" width="256" height="48" rx="8" />
      <text x="580" y="197">{d.tx}</text>
    </g>
    <g class="hd-node n5 hd-node--db">
      <rect x="784" y="122" width="180" height="56" rx="8" />
      <text x="874" y="148">SQL Server</text>
      <text class="sub" x="874" y="166">{lang === 'es' ? 'T-SQL · índices' : 'T-SQL · indexes'}</text>
    </g>
    <g class="hd-node hd-node--pill n6">
      <rect x="262" y="236" width="130" height="30" rx="15" />
      <text x="327" y="256">{d.logs}</text>
    </g>

    <text class="hd-cap hd-resp" x="500" y="26">{d.resp}</text>
  </svg>
  <!-- Versión vertical para teléfonos: el mismo recorrido, de arriba abajo. -->
  <svg class="hd-v" viewBox="0 0 340 500" aria-hidden="true">
    <rect class="hd-core" x="16" y="188" width="308" height="200" rx="12" />
    <text class="hd-cap" x="32" y="210">{d.core}</text>

    <g class="hd-edges">
      <path d="M130 64 V 100" />
      <path d="M130 152 C 130 176, 170 196, 170 224" />
      <path d="M170 268 V 316" />
      <path d="M170 360 C 170 380, 130 396, 130 414" />
      <path class="dash" d="M220 440 C 330 440, 330 38, 220 38" />
      <path class="dash" d="M220 126 H 236" />
    </g>

    <g class="hd-pulses">
      <path pathLength="100" class="p p1" d="M130 64 V 100" />
      <path pathLength="100" class="p p2" d="M130 152 C 130 176, 170 196, 170 224" />
      <path pathLength="100" class="p p3" d="M170 268 V 316" />
      <path pathLength="100" class="p p4" d="M170 360 C 170 380, 130 396, 130 414" />
      <path pathLength="100" class="p p5" d="M220 440 C 330 440, 330 38, 220 38" />
      <path pathLength="100" class="p p6" d="M220 126 H 236" />
    </g>

    <g class="hd-node n1">
      <rect x="40" y="12" width="180" height="52" rx="8" />
      <text x="130" y="36">{d.browser}</text>
      <text class="sub" x="130" y="53">HTTPS</text>
    </g>
    <g class="hd-node n2">
      <rect x="40" y="100" width="180" height="52" rx="8" />
      <text x="130" y="124">API REST</text>
      <text class="sub" x="130" y="141">Java</text>
    </g>
    <g class="hd-node hd-node--pill n6">
      <rect x="236" y="111" width="92" height="30" rx="15" />
      <text x="282" y="130">logs</text>
    </g>
    <g class="hd-node n3">
      <rect x="40" y="224" width="260" height="44" rx="8" />
      <text x="170" y="251">{d.rules}</text>
    </g>
    <g class="hd-node n4">
      <rect x="40" y="316" width="260" height="44" rx="8" />
      <text x="170" y="343">{d.tx}</text>
    </g>
    <g class="hd-node n5 hd-node--db">
      <rect x="40" y="414" width="180" height="52" rx="8" />
      <text x="130" y="438">SQL Server</text>
      <text class="sub" x="130" y="455">{lang === 'es' ? 'T-SQL · índices' : 'T-SQL · indexes'}</text>
    </g>
    <text class="hd-cap" x="300" y="246" transform="rotate(90 300 246)" text-anchor="middle">{d.resp}</text>
  </svg>
</figure>
