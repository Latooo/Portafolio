---
/**
 * Título de sección con máscara: el texto sube desde su propia caja al entrar en pantalla.
 * El estado oculto solo existe si el script de movimiento está activo (ver motion.css),
 * así que sin JS o con reduced-motion el título es siempre visible.
 */
interface Props {
  id: string;
  text: string;
  class?: string;
}

const { id, text, class: className = '' } = Astro.props;
---

<h2 class={`section-title display ${className}`.trim()} id={id}>
  <span class="rv" data-rv><span class="rv-in">{text}</span></span>
</h2>
