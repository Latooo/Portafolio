---
import Nav from './Nav.astro';
import { getContent, site, type Lang } from '../data';
import { asset } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<header class="hero">
  <Nav lang={lang} />
  <div class="intro">
    <p class="role display">{t.hero.role}</p>
    <p class="tagline">{t.hero.tagline}</p>
    <div class="actions">
      <a class="btn" href={`mailto:${site.email}`}>{t.hero.ctaWrite}</a>
      <a class="textlink" href={asset(site.cv)} download>{t.hero.ctaCv}</a>
    </div>
  </div>
  <div class="name"><h1 class="display">{site.name}</h1></div>
</header>
