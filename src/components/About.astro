---
import { Picture } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import SectionTitle from './SectionTitle.astro';
import { getContent, type Lang } from '../data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).about;
---

<section class="field" id="about" aria-labelledby="about-title">
  <SectionTitle id="about-title" text={t.title} />
  <div class="about-grid">
    <div>
      <figure class="avatar">
        <Picture
          src={avatar}
          alt={t.avatarAlt}
          widths={[320, 640]}
          sizes="(max-width: 820px) 80vw, 420px"
          formats={['avif', 'webp']}
          width={640}
          height={640}
          loading="lazy"
        />
      </figure>
      <dl class="facts">
        {
          t.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="about-text">
      {t.paragraphs.map((p) => <p set:html={p} />)}
    </div>
  </div>
</section>
